---
import type { CollectionEntry } from 'astro:content';

interface Props {
  architecture: CollectionEntry<'projets'>['data']['architecture'];
}
const { architecture } = Astro.props;
const { noeuds, liens } = architecture;

// Grille : 4 colonnes de 265 unités, rangées de 150 ; un nœud fait 228 × 80.
const W = 228;
const H = 80;
const pos = (n: (typeof noeuds)[number]) => ({ x: 20 + n.col * 265, y: 20 + n.rang * 150 });
const byId = new Map(noeuds.map((n) => [n.id, n]));
const rangs = Math.max(...noeuds.map((n) => n.rang)) + 1;
const VH = 20 + (rangs - 1) * 150 + H + 20;

// Un détail trop long pour le nœud (mono 12,5 px : ~26 signes) passe sur deux lignes.
const MAX = 26;
const lignes = (t: string): string[] => {
  if (t.length <= MAX) return [t];
  const mots = t.split(' ');
  let a = '';
  while (mots.length && (a + ' ' + mots[0]).trim().length <= MAX) a = (a + ' ' + mots.shift()).trim();
  return [a, mots.join(' ')];
};
const vers = (id: string) =>
  liens
    .filter(([a]) => a === id)
    .map(([, b]) => byId.get(b)!.label)
    .join(', ');

const chemins = liens.map(([a, b]) => {
  const A = pos(byId.get(a)!);
  const B = pos(byId.get(b)!);
  if (A.y === B.y) {
    const [g, d] = A.x < B.x ? [A, B] : [B, A];
    return `M${g.x + W} ${g.y + H / 2} H${d.x}`;
  }
  const [h, b2] = A.y < B.y ? [A, B] : [B, A];
  const xh = h.x + W / 2;
  const xb = b2.x + W / 2;
  const ym = h.y + H + (b2.y - h.y - H) / 2;
  return xh === xb ? `M${xh} ${h.y + H} V${b2.y}` : `M${xh} ${h.y + H} V${ym} H${xb} V${b2.y}`;
});
---
<figure class="schema" data-schema>
  <svg viewBox={`0 0 1070 ${VH}`} aria-hidden="true">
    {chemins.map((d, i) => <path class="lien" d={d} pathLength="1" style={`--i:${i}`} />)}
    {
      noeuds.map((n, i) => {
        const p = pos(n);
        return (
          <g class="noeud" style={`--i:${i}`}>
            <rect x={p.x} y={p.y} width={W} height={H} />
            {n.detail && lignes(n.detail).length > 1 ? (
              <>
                <text class="lab" x={p.x + 14} y={p.y + 28}>{n.label}</text>
                <text class="det" x={p.x + 14} y={p.y + 50}>
                  {lignes(n.detail).map((l, k) => <tspan x={p.x + 14} dy={k ? 15 : 0}>{l}</tspan>)}
                </text>
              </>
            ) : (
              <>
                <text class="lab" x={p.x + 14} y={p.y + 32}>{n.label}</text>
                {n.detail && <text class="det" x={p.x + 14} y={p.y + 58}>{n.detail}</text>}
              </>
            )}
          </g>
        );
      })
    }
  </svg>
  <ul class="liste mono">
    {
      noeuds.map((n) => (
        <li>
          <strong>{n.label}</strong>
          {n.detail && <span>{n.detail}</span>}
          {vers(n.id) && <span class="vers">{vers(n.id)}</span>}
        </li>
      ))
    }
  </ul>
</figure>

<style>
  .schema {
    position: relative;
  }
  svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .lien {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 0.9s var(--ease) calc(0.25s + var(--i) * 0.08s);
  }
  .noeud rect {
    fill: var(--bg);
    stroke: currentColor;
    stroke-width: 1.5;
  }
  .noeud {
    clip-path: inset(0 100% 0 0);
    transition: clip-path 0.6s var(--ease) calc(var(--i) * 0.06s);
  }
  .lab {
    font-family: var(--sans);
    font-size: 22px;
    letter-spacing: -0.02em;
    fill: currentColor;
  }
  .det {
    font-family: var(--mono);
    font-size: 12.5px;
    fill: currentColor;
  }
  [data-trace='1'] .lien {
    stroke-dashoffset: 0;
  }
  [data-trace='1'] .noeud {
    clip-path: inset(0 0 0 0);
  }
  /* Sur ordinateur, la liste double le schéma pour les lecteurs d'écran. */
  .liste {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    list-style: none;
    border-top: 1px solid var(--fg);
  }
  .liste li {
    display: grid;
    gap: 0.1rem;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--fg);
  }
  .liste strong {
    font-family: var(--sans);
    font-weight: 500;
    font-size: var(--t-base);
  }
  .vers::before {
    content: 'relié à : ';
  }
  @media (max-width: 700px) {
    svg {
      display: none;
    }
    .liste {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip-path: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lien,
    .noeud {
      transition: none;
    }
  }
</style>
