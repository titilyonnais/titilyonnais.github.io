---
const sommaire = [
  { n: '01', href: '#postship', label: 'PostShip', note: 'surveillance après mise en ligne' },
  { n: '02', href: '#clipper', label: 'Clipper', note: 'presse-papiers pour Windows' },
  { n: '03', href: '#aether', label: 'ÆTHER', note: 'navigateur sans onglets' },
];
---
<section class="hero ink" data-hero data-lignes="THIBAULT|MORRETTON">
  <h1 class="titre">Thibault Morretton</h1>
  <div class="plaque" aria-hidden="true">
    <canvas></canvas>
  </div>
  <div class="pied wrap grid">
    <p class="accroche">Je fabrique des logiciels.</p>
    <ol class="sommaire mono">
      {
        sommaire.map((s) => (
          <li>
            <a href={s.href}>
              <span class="num">{s.n}</span>
              <span class="lab">{s.label}</span>
              <span class="note">{s.note}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .hero {
    position: relative;
    height: 100svh;
    min-height: 560px;
    display: grid;
    grid-template-rows: 1fr auto;
  }
  .titre {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .plaque {
    position: relative;
    min-height: 0;
    margin-top: var(--nav-h);
  }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    image-rendering: pixelated;
  }
  .pied {
    align-items: end;
    padding-block: 1.25rem 1.75rem;
    border-top: 1px solid var(--fg);
  }
  .accroche {
    grid-column: 1 / span 7;
    font-size: var(--t-l);
    font-weight: 450;
    letter-spacing: var(--track-title);
    line-height: 1;
  }
  .sommaire {
    grid-column: 8 / -1;
    list-style: none;
  }
  .sommaire a {
    display: grid;
    grid-template-columns: 2.5em 6em 1fr;
    gap: 0.5em;
    padding-block: 0.2rem;
    text-decoration: none;
  }
  .sommaire a:hover .lab {
    text-decoration: underline;
  }
  .note {
    text-align: right;
  }

  /* Sans WebGL : le nom s’écrit en toutes lettres. */
  :global(html[data-dither='off']) .titre {
    position: static;
    width: auto;
    height: auto;
    clip-path: none;
    white-space: normal;
    align-self: center;
    padding: calc(var(--nav-h) + 1rem) var(--gutter) 0;
    font-size: var(--t-mega);
    font-stretch: 125%;
    font-weight: 500;
    text-transform: uppercase;
    line-height: 0.88;
  }
  :global(html[data-dither='off']) .plaque {
    display: none;
  }

  @media (max-width: 767px) {
    .accroche,
    .sommaire {
      grid-column: 1 / -1;
    }
    .accroche {
      margin-bottom: 1rem;
    }
    .sommaire a {
      grid-template-columns: 2.5em 1fr;
    }
    .note {
      display: none;
    }
  }
</style>
