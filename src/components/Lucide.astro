---
import { ICONES, type Icone } from '../lib/icones-lucide';

interface Props {
  nom: Icone;
  taille?: number;
}
const { nom, taille = 16 } = Astro.props;
---
<svg width={taille} height={taille} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={ICONES[nom]} />
