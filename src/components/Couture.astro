---
interface Props {
  de: 'ink' | 'paper';
  vers: 'ink' | 'paper';
  graine?: number;
}
const { de, vers, graine = 0 } = Astro.props;
---
<div class={`couture de-${de} vers-${vers}`} data-couture data-de={de} data-vers={vers} data-graine={graine} aria-hidden="true">
  <canvas></canvas>
</div>

<style>
  /* Avant le premier dessin (ou sans JS) : une coupe nette à mi-hauteur. */
  .couture {
    position: relative;
    height: 75svh;
    display: grid;
    grid-template-rows: 1fr 1fr;
  }
  .couture::before,
  .couture::after {
    content: '';
  }
  .de-ink::before { background: var(--ink); }
  .de-paper::before { background: var(--paper); }
  .vers-ink::after { background: var(--ink); }
  .vers-paper::after { background: var(--paper); }
  canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  @media (max-width: 767px) {
    .couture {
      height: 45svh;
    }
  }
</style>
