---
import type { CollectionEntry } from 'astro:content';
import Fleche from '../Fleche.astro';

interface Props {
  projet: CollectionEntry<'projets'>;
  fond: 'ink' | 'paper';
  numero: string;
  pin: number;
  temps: string[];
  resume: string;
}
const { projet, fond, numero, pin, temps, resume } = Astro.props;
const { nom, phrase, faits, liens, stack } = projet.data;
const id = projet.id;
---
<section id={id} class={`projet ${fond}`} aria-labelledby={`${id}-titre`}>
  <div class="piste" data-scene={id} style={`--pin: ${pin}`}>
    <div class="scene">
      <div class="wrap grid cadre">
        <header class="tete">
          <div class="etiquette mono"><span>{numero}</span><span>{projet.data.etat}</span></div>
          <h2 id={`${id}-titre`} class="nom" data-etire>{nom}</h2>
          <p class="phrase">{phrase}</p>
          <ol class="temps mono">
            {temps.map((t, i) => <li data-temps={i}><span>{String(i + 1).padStart(2, '0')}</span>{t}</li>)}
          </ol>
        </header>
        <div class="visuel" aria-hidden="true" style={`view-transition-name: visuel-${id}`}>
          <svg class="repere r1" viewBox="0 0 20 20"><circle cx="10" cy="10" r="5" /><path d="M10 0v20M0 10h20" /></svg>
          <svg class="repere r2" viewBox="0 0 20 20"><circle cx="10" cy="10" r="5" /><path d="M10 0v20M0 10h20" /></svg>
          <svg class="repere r3" viewBox="0 0 20 20"><circle cx="10" cy="10" r="5" /><path d="M10 0v20M0 10h20" /></svg>
          <svg class="repere r4" viewBox="0 0 20 20"><circle cx="10" cy="10" r="5" /><path d="M10 0v20M0 10h20" /></svg>
          <slot />
        </div>
      </div>
      <p class="sr-only">{resume}</p>
    </div>
  </div>

  <div class="sortie wrap grid">
    <dl class="faits">
      {
        faits.map((f) => (
          <div>
            <dt class="valeur">{f.valeur}</dt>
            <dd class="mono">{f.libelle}</dd>
          </div>
        ))
      }
    </dl>
    <div class="bas">
      <p class="stack mono">{stack.join(' · ')}</p>
      <ul class="liens mono">
        {
          liens.map((l) => (
            <li>
              <a href={l.href}>
                {l.label} <Fleche sens="diag" />
              </a>
            </li>
          ))
        }
        <li class="cas">
          <a href={`/projets/${id}/`}>
            Étude de cas <Fleche />
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .cadre {
    height: 100%;
    padding-block: calc(var(--nav-h) + 1.5rem) 2rem;
    align-items: stretch;
  }
  .tete {
    grid-column: 1 / span 4;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  .nom {
    font-size: var(--t-xl);
    margin-top: 1rem;
    hyphens: none;
  }
  .phrase {
    font-size: var(--t-base);
    max-width: 34ch;
  }
  .temps {
    list-style: none;
    margin-top: auto;
    border-top: 1px solid var(--fg);
  }
  .temps li {
    display: flex;
    gap: 1.5em;
    padding: 0.35rem 0.4rem;
    border-bottom: 1px solid var(--fg);
    text-transform: uppercase;
  }
  /* Le temps en cours s'inverse, comme une ligne sélectionnée. */
  .temps li:global(.actif) {
    background: var(--fg);
    color: var(--bg);
  }
  .visuel {
    grid-column: 6 / -1;
    position: relative;
    min-height: 0;
  }
  .repere {
    position: absolute;
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    z-index: 2;
  }
  .r1 { top: -10px; left: -10px; }
  .r2 { top: -10px; right: -10px; }
  .r3 { bottom: -10px; left: -10px; }
  .r4 { bottom: -10px; right: -10px; }

  .sortie {
    padding-block: 4rem 6rem;
    row-gap: 3rem;
  }
  .faits {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--col-gap);
  }
  .faits div {
    border-top: 1px solid var(--fg);
    padding-top: 0.75rem;
  }
  .valeur {
    font-size: var(--t-l);
    letter-spacing: var(--track-title);
    line-height: 1;
    margin-bottom: 0.5rem;
  }
  .faits dd {
    max-width: 26ch;
  }
  .bas {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: baseline;
  }
  .stack {
    max-width: 60ch;
  }
  .liens {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
  }
  .cas a {
    background: var(--fg);
    color: var(--bg);
    padding: 0.55rem 0.9rem;
    text-decoration: none;
    text-transform: uppercase;
    display: inline-flex;
    gap: 0.75em;
    align-items: center;
  }
  .cas a:hover {
    outline: 1px solid var(--fg);
    outline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .tete {
      grid-column: 1 / -1;
      gap: 0.6rem;
    }
    .nom {
      font-size: var(--t-l);
      margin-top: 0.25rem;
    }
    .phrase {
      font-size: var(--t-s);
    }
    .temps li:not(:global(.actif)) {
      display: none;
    }
    .temps {
      margin-top: 0.25rem;
    }
    .cadre {
      grid-template-rows: auto 1fr;
      row-gap: 1.25rem;
      padding-top: calc(var(--nav-h) + 1.5rem);
    }
    .visuel {
      grid-column: 1 / -1;
    }
    .faits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .cadre {
      min-height: 100svh;
    }
    .visuel {
      min-height: 70svh;
    }
  }
</style>
