---
import type { CollectionEntry } from 'astro:content';
import SceneProjet from './SceneProjet.astro';

interface Props {
  projet: CollectionEntry<'projets'>;
}
const { projet } = Astro.props;

// Entoure chaque occurrence de « facture » de caractères adressables : la scène
// les inverse au fur et à mesure que la requête se tape.
const MOT = 'facture';
function surligne(texte: string): string {
  const esc = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  let out = '';
  let i = 0;
  const bas = texte.toLowerCase();
  for (;;) {
    const j = bas.indexOf(MOT, i);
    if (j < 0) break;
    out += esc(texte.slice(i, j));
    out += [...texte.slice(j, j + MOT.length)].map((c, k) => `<span class="c" data-k="${k}">${esc(c)}</span>`).join('');
    i = j + MOT.length;
  }
  return out + esc(texte.slice(i));
}

// Vignette tramée d'une capture d'écran : une page de facture, en demi-teinte.
const vignette = (() => {
  const W = 30;
  const H = 20;
  let c = '';
  for (let y = 0; y < H; y++) {
    for (let x = 0; x < W; x++) {
      const entete = y >= 2 && y <= 4 && x >= 3 && x <= 16;
      const ligne = y >= 7 && y % 3 === 1 && x >= 3 && x <= 26 - ((y * 7) % 9);
      const total = y >= 16 && y <= 17 && x >= 18 && x <= 26;
      const v = entete || total ? 0.9 : ligne ? 0.55 : 0.08;
      const r = Math.sqrt(v / Math.PI) * 1;
      c += `<circle cx="${x + 0.5}" cy="${y + 0.5}" r="${r.toFixed(2)}"/>`;
    }
  }
  return `<svg viewBox="0 0 ${W} ${H}" class="vign">${c}</svg>`;
})();

type El = { type: string; html: string; meta: string; cherche: string; arrivee: number; classe?: string };
const elements: El[] = [
  { type: 'secret', classe: 'secret', html: '<span class="cle" data-cle="sk-live-4f9a2c71e0b8"></span>', meta: 'Terminal · 10:03', cherche: '', arrivee: 5 },
  { type: 'fichier', html: `${surligne('facture-septembre.pdf')}<span class="poids">184 Ko</span>`, meta: 'Explorateur · 09:52', cherche: 'facture-septembre.pdf', arrivee: 4 },
  { type: 'image', html: `<span class="img-row">${vignette}<span class="img-txt"><span>capture-2026-10-01.png</span><span class="ocr">texte lu : « ${surligne('Facture')} n° 2026-118 »</span></span></span>`, meta: 'Capture · 09:40', cherche: 'capture facture n° 2026-118', arrivee: 3 },
  { type: 'lien', html: 'https://postship.fr/docs/cli', meta: 'Firefox · 09:31', cherche: 'https://postship.fr/docs/cli', arrivee: 2 },
  { type: 'code', html: '<u>const</u> total = lignes.reduce((s, l) =&gt; s + l.prix, 0);', meta: 'VS Code · 09:20', cherche: 'const total = lignes.reduce((s, l) => s + l.prix, 0);', arrivee: 1 },
  { type: 'texte', html: `${surligne('Facture')} n° 2026-118, à régler avant le 15.`, meta: 'Outlook · 09:12', cherche: 'facture n° 2026-118, à régler avant le 15.', arrivee: 0 },
];
---
<SceneProjet
  projet={projet}
  fond="paper"
  numero="02"
  pin={3}
  temps={['Copier', 'Chercher', 'Protéger']}
  resume="Démonstration : dans Clipper, les éléments copiés s'empilent (texte, code, lien, capture d'écran, fichier). La recherche « facture » filtre la liste lettre par lettre, y compris le texte lu dans la capture. Une clé d'API copiée est détectée, masquée et exclue de la recherche."
>
  <div class="cl">
    <div class="fen">
      <div class="barre mono">
        <span>Clipper</span>
        <span class="kbd"><kbd>Win</kbd><span>+</span><kbd>V</kbd></span>
      </div>
      <div class="recherche mono">
        <span class="q" data-texte="facture"></span><span class="curseur"></span>
        <span class="vide">Rechercher</span>
      </div>
      <ul class="liste">
        {
          elements.map((e) => (
            <li class:list={['el', e.classe]} data-arrivee={e.arrivee} data-cherche={e.cherche}>
              <div class="in">
                <span class="tag mono">{e.type}</span>
                <span class="contenu mono" set:html={e.html} />
                <span class="meta mono">{e.meta}</span>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="statut mono">
        <span class="compte"></span>
        <span>local · rien ne quitte le PC</span>
      </div>
    </div>
  </div>
</SceneProjet>

<style>
  .cl {
    height: 100%;
    display: grid;
    align-items: start;
  }
  .fen {
    border: 1px solid var(--fg);
    display: flex;
    flex-direction: column;
    max-height: 100%;
  }
  .barre {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.5rem 0.75rem;
    background: var(--fg);
    color: var(--bg);
    text-transform: uppercase;
  }
  .kbd {
    display: flex;
    gap: 0.35rem;
    align-items: center;
  }
  kbd {
    font: inherit;
    border: 1px solid var(--bg);
    padding: 0 0.35rem;
  }
  .recherche {
    position: relative;
    font-size: var(--t-m);
    padding: 0.9rem 0.75rem;
    border-bottom: 1px solid var(--fg);
    display: flex;
    align-items: center;
    min-height: 3.6rem;
  }
  .vide {
    position: absolute;
    left: 2.1rem;
    visibility: hidden;
  }
  .cl:global(.sans-requete) .vide {
    visibility: visible;
  }
  .curseur {
    display: inline-block;
    width: 2px;
    height: 1.2em;
    background: var(--fg);
    margin-left: 2px;
    animation: clignote 1s steps(1) infinite;
  }
  .recherche::before {
    content: '';
    width: 0.9rem;
    height: 0.9rem;
    border: 1.5px solid var(--fg);
    margin-right: 0.75rem;
    flex: none;
  }
  @keyframes clignote {
    50% { visibility: hidden; }
  }

  .liste {
    list-style: none;
    overflow: hidden;
  }
  /* Un élément arrive ou se replie : la rangée passe de 0 à sa hauteur. */
  .el {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s var(--ease);
  }
  .el:global(.la):not(:global(.filtre)) {
    grid-template-rows: 1fr;
  }
  .in {
    min-height: 0;
    overflow: hidden;
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) auto;
    gap: 0.75rem;
    align-items: center;
    padding-inline: 0.75rem;
    box-sizing: border-box;
  }
  .el:global(.la):not(:global(.filtre)) .in {
    padding-block: 1.15rem;
    border-bottom: 1px solid var(--fg);
  }
  .el:global(.sel) .in {
    background: var(--fg);
    color: var(--bg);
  }
  .el:global(.sel) .tag {
    border-color: var(--bg);
  }
  .tag {
    border: 1px solid var(--fg);
    text-align: center;
    text-transform: uppercase;
    padding: 0.05rem 0;
  }
  .contenu {
    font-size: var(--t-s);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .contenu :global(.img-row) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .contenu :global(u) {
    text-underline-offset: 0.18em;
  }
  .contenu :global(.vign) {
    width: 3.6rem;
    flex: none;
    border: 1px solid currentColor;
    fill: currentColor;
  }
  .contenu :global(.img-txt) {
    display: grid;
    min-width: 0;
  }
  .contenu :global(.ocr) {
    font-size: var(--t-xs);
  }
  .contenu :global(.poids) {
    font-size: var(--t-xs);
    margin-left: 0.75rem;
  }
  .contenu :global(.c.hit) {
    background: var(--fg);
    color: var(--bg);
  }
  .el:global(.sel) .contenu :global(.c.hit) {
    background: var(--bg);
    color: var(--fg);
  }
  .el:global(.masque) .tag {
    background: var(--fg);
    color: var(--bg);
  }
  .meta {
    white-space: nowrap;
  }
  .statut {
    border-top: 1px solid var(--fg);
    margin-top: -1px;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.5rem 0.75rem;
  }

  @media (max-width: 1023px) {
    .in {
      grid-template-columns: 3.6rem minmax(0, 1fr);
      gap: 0.5rem;
    }
    .meta {
      display: none;
    }
    .recherche {
      font-size: var(--t-base);
      min-height: 3rem;
      padding-block: 0.6rem;
    }
    .el:global(.la):not(:global(.filtre)) .in {
      padding-block: 0.55rem;
    }
    .contenu {
      font-size: var(--t-xs);
    }
    .tag {
      font-size: 0.625rem;
    }
  }
</style>
