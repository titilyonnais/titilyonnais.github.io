---
import '../styles/tokens.css';
import '../styles/base.css';
import Nav from '../components/Nav.astro';
import Prechargeur from '../components/Prechargeur.astro';

interface Props {
  title: string;
  description: string;
  /** Une étude de cas prend l'univers de son produit (body.univers-<id>, voir demos/univers.css). */
  univers?: string;
}
const { title, description, univers } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="black" />
    <meta name="color-scheme" content="dark light" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href="/fonts/mona-sans-latin-standard-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/ibm-plex-mono-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Thibault Morretton" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <noscript>
      <style is:inline>
        .pre { display: none !important; }
        .mot { color: var(--fg) !important; }
        .el { grid-template-rows: 1fr !important; }
        .b { --r: 1 !important; }
        .filet { --s: 1 !important; }
        .lab { visibility: visible !important; }
        [data-schema] .lien { stroke-dashoffset: 0 !important; }
        [data-schema] .noeud { clip-path: none !important; }
      </style>
    </noscript>
  </head>
  <body class={univers ? `univers-${univers}` : undefined}>
    <Prechargeur />
    <slot name="ciel" />
    <canvas id="particules" aria-hidden="true"></canvas>
    <a class="skip" href="#contenu">Aller au contenu</a>
    <Nav />
    <main id="contenu">
      <slot />
    </main>
    <script>
      import '../lib/boot';
    </script>
  </body>
</html>

<style is:global>
  /* Lenis */
  html.lenis,
  html.lenis body {
    height: auto;
  }
  .lenis:not(.lenis-autoToggle).lenis-stopped {
    overflow: clip;
  }
  .lenis.lenis-smooth [data-lenis-prevent] {
    overscroll-behavior: contain;
  }

  /* Titres qui s’élargissent à l’arrivée (voir lib/titres.ts). */
  [data-etire] {
    transition: font-stretch 1.2s var(--ease-out), letter-spacing 1.2s var(--ease-out);
  }
  html[data-etire='on'] [data-etire]:not([data-etire='vu']) {
    font-stretch: 75%;
    letter-spacing: -0.02em;
  }
</style>
