---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Fleche from '../../components/Fleche.astro';
import Figure from '../../components/cas/Figure.astro';
import Schema from '../../components/cas/Schema.astro';
import AetherCiel from '../../demos/aether/Ciel.astro';
import '../../styles/polices-produits.css';
import '../../demos/postship/tokens.css';
import '../../demos/clipper/tokens.css';
import '../../demos/aether/tokens.css';
import '../../demos/univers.css';

export async function getStaticPaths() {
  const projets = await getCollection('projets');
  return projets.map((projet) => ({ params: { slug: projet.id }, props: { projet } }));
}
const { projet } = Astro.props;
const { Content } = await render(projet);
const d = projet.data;
const suivant = (await getEntry('projets', d.suivant))!;
const n = String(d.ordre).padStart(2, '0');
const id = projet.id;

// Le logo se forme en particules à l'ouverture, dans la teinte du produit.
const TEINTES: Record<string, string> = {
  postship: '--teinte-postship',
  clipper: '--teinte-clipper',
  aether: '--teinte-aether-1,--teinte-aether-2',
};
// Sans WebGL, le vrai logo du produit le remplace.
const LOGOS: Record<string, string> = {
  postship: '/produits/postship/logo.svg',
  clipper: '/produits/clipper/logo.svg',
  aether: '/produits/aether/icone.png',
};
// PostShip : ses vraies illustrations (le texte alternatif est celui des SVG).
type Illus = { src: string; alt: string; w: number; h: number };
const ILLUS: Record<string, { fonctions: Illus[]; construit: Illus[] }> = {
  postship: {
    fonctions: [
      { src: '/produits/postship/deploiement.svg', w: 860, h: 215, alt: 'Un commit part chez l’hébergeur ; le webhook prévient PostShip à la seconde, qui vérifie chaque page et rend un verdict.' },
      { src: '/produits/postship/parcours.svg', w: 860, h: 180, alt: 'Un parcours de paiement en trois étapes, jouées dans l’ordre ; la troisième a cassé.' },
    ],
    construit: [
      { src: '/produits/postship/alerte.svg', w: 860, h: 200, alt: 'L’alerte arrive sur le téléphone et sur le salon, en un seul message ; quand tout passe, rien ne part.' },
      { src: '/produits/postship/retour-arriere.svg', w: 860, h: 165, alt: 'Trois déploiements sur une frise ; le dernier a cassé, la production repointe sur le précédent vérifié bon.' },
    ],
  },
};
const illus = ILLUS[id];
---
<Base title={`${d.nom}, étude de cas — Thibault Morretton`} description={d.phrase} univers={id}>
  {id === 'aether' && <AetherCiel slot="ciel" statique />}
  <header class="ouverture ink" data-station="cas-logo" data-fond={id === 'aether' ? 'aucun' : 'ink'} data-forme={id} data-teinte={TEINTES[id]}>
    <div class="logo" data-place>
      <img class="logo-secours" src={LOGOS[id]} alt="" width="160" height="160" />
    </div>
    <div class="o-texte wrap">
      <div class="etiquette mono"><span>{n}</span><span>Étude de cas</span></div>
      <h1 class="titre">{d.nom}</h1>
      <p class="phrase">{d.phrase}</p>
    </div>
  </header>
  <section class="tete ink" aria-label="En bref">
    <div class="wrap grid intro">
      <dl class="meta mono">
        <div><dt>État</dt><dd>{d.etat}</dd></div>
        <div><dt>Période</dt><dd>{d.periode}</dd></div>
        <div><dt>Stack</dt><dd>{d.stack.join(' · ')}</dd></div>
        <div>
          <dt>Liens</dt>
          <dd class="liens">
            {d.liens.map((l) => <a href={l.href}>{l.label} <Fleche sens="diag" /></a>)}
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="bloc paper" aria-labelledby="probleme">
    <div class="wrap grid">
      <div class="etiquette mono"><span>01</span><span id="probleme">Le problème</span></div>
      <p class="grand">{d.probleme}</p>
    </div>
    <div class="wrap grid fonctions">
      <div class="etiquette mono"><span>02</span><span id="fonctions">Ce que ça fait</span></div>
      {
        d.fonctions.map((f, i) => (
          <article class="fonction">
            <div class="f-texte">
              <span class="mono">{String(i + 1).padStart(2, '0')}</span>
              <h2>{f.titre}</h2>
              <p>{f.texte}</p>
            </div>
            <Figure figure={f.figure} />
          </article>
        ))
      }
      {illus && (
        <div class="illus">
          {illus.fonctions.map((i) => <img src={i.src} alt={i.alt} width={i.w} height={i.h} loading="lazy" />)}
        </div>
      )}
    </div>
  </section>

  <section class="bloc ink" aria-labelledby="construit">
    <div class="wrap grid">
      <div class="etiquette mono"><span>03</span><span id="construit">Comment c’est construit</span></div>
      <div class="schema-zone"><Schema architecture={d.architecture} /></div>
      {illus && (
        <div class="illus">
          {illus.construit.map((i) => <img src={i.src} alt={i.alt} width={i.w} height={i.h} loading="lazy" />)}
        </div>
      )}
      <div class="prose"><Content /></div>
    </div>
    <div class="wrap grid">
      <div class="etiquette mono"><span>04</span><span>Les chiffres</span></div>
      <dl class="faits">
        {
          d.faits.map((f) => (
            <div>
              <dt>{f.valeur}</dt>
              <dd class="mono">{f.libelle}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="bloc paper fin" aria-labelledby="appris">
    <div class="wrap grid">
      <div class="etiquette mono"><span>05</span><span id="appris">Ce que j’en ai appris</span></div>
      <p class="grand">{d.appris}</p>
    </div>
    <nav class="wrap suite" aria-label="Étude de cas suivante">
      <a class="suivant" href={`/projets/${suivant.id}/`}>
        <span class="mono">Suivant</span>
        <span class="nom-suivant" data-etire>{suivant.data.nom} <Fleche /></span>
      </a>
      <a class="retour mono" href={`/#${projet.id}`}><Fleche sens="gauche" /> Retour à l’accueil</a>
    </nav>
  </section>
</Base>

<style>
  /* L'ouverture : le logo du produit se forme en particules, le nom en dessous. */
  .ouverture {
    position: relative;
    min-height: 90svh;
    display: grid;
    align-content: end;
    padding-top: var(--nav-h);
  }
  .logo {
    position: absolute;
    top: calc(var(--nav-h) + 2rem);
    right: calc(var(--gutter) * 2);
    width: min(36vw, 48svh);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
  }
  .logo-secours {
    width: 50%;
    height: auto;
    visibility: hidden;
  }
  :global(html:not([data-particules='on'])) .logo-secours {
    visibility: visible;
  }
  .o-texte {
    position: relative;
    display: grid;
    gap: 1rem;
    padding-bottom: 3rem;
  }
  .titre {
    font-size: var(--t-mega);
    font-stretch: 125%;
    font-weight: 500;
    line-height: 0.9;
    text-transform: uppercase;
  }
  .o-texte .phrase {
    grid-column: auto;
    font-size: var(--t-m);
    line-height: 1.2;
    max-width: 36ch;
  }
  .tete {
    position: relative;
    display: grid;
  }
  .intro {
    border-top: 1px solid var(--fg);
    padding-block: 1.5rem 4rem;
    row-gap: 2.5rem;
  }
  .illus {
    grid-column: 1 / -1;
    display: grid;
    gap: 2rem;
    padding-block: 3rem;
  }
  .illus img {
    width: 100%;
    height: auto;
  }
  .etiquette {
    grid-column: 1 / -1;
  }
  .phrase {
    grid-column: 1 / span 7;
    font-size: var(--t-l);
    letter-spacing: var(--track-title);
    line-height: 1.05;
    font-weight: 450;
    max-width: none;
  }
  .meta {
    grid-column: 1 / -1;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .meta div {
    border-top: 1px solid var(--fg);
    padding-top: 0.4rem;
  }
  dt {
    text-transform: uppercase;
  }
  .liens {
    display: grid;
  }

  .bloc {
    padding-block: 6rem 8rem;
  }
  .bloc .wrap + .wrap {
    margin-top: 8rem;
  }
  .bloc .etiquette {
    margin-bottom: 2.5rem;
  }
  .grand {
    grid-column: 1 / span 10;
    font-size: var(--t-l);
    letter-spacing: var(--track-title);
    line-height: 1.08;
    font-weight: 450;
    max-width: none;
  }
  .fonctions {
    row-gap: 0;
  }
  .fonction {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: var(--col-gap) calc(var(--col-gap) * 3);
    padding-block: 2.5rem;
    border-top: 1px solid var(--fg);
    align-items: center;
  }
  .fonction:last-child {
    border-bottom: 1px solid var(--fg);
  }
  .f-texte {
    display: grid;
    gap: 0.75rem;
  }
  .f-texte h2 {
    font-size: var(--t-l);
  }
  .schema-zone {
    grid-column: 1 / -1;
    margin-bottom: 4rem;
  }
  .prose {
    grid-column: 1 / span 8;
    display: grid;
    gap: 1.2em;
    font-size: var(--t-m);
    line-height: 1.45;
  }
  .prose :global(code) {
    font-family: var(--mono);
    font-size: 0.8em;
    border: 1px solid currentColor;
    padding: 0 0.25em;
    white-space: nowrap;
  }
  .prose :global(strong) {
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.15em;
  }
  .faits {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--col-gap);
  }
  .faits div {
    border-top: 1px solid var(--fg);
    padding-top: 0.75rem;
  }
  .faits dt {
    text-transform: none;
    font-size: var(--t-xl);
    letter-spacing: var(--track-title);
    line-height: 1;
    margin-bottom: 0.75rem;
  }
  .suite {
    margin-top: 8rem;
    display: grid;
    gap: 2rem;
  }
  .suivant {
    display: grid;
    gap: 0.5rem;
    text-decoration: none;
    border-top: 1px solid var(--fg);
    padding-top: 1rem;
  }
  .nom-suivant {
    font-size: var(--t-mega);
    letter-spacing: var(--track-title);
    line-height: 0.9;
    font-weight: 450;
    display: inline-flex;
    align-items: center;
    gap: 0.2em;
    transition: font-stretch 0.6s var(--ease-out);
  }
  .suivant:hover .nom-suivant {
    font-stretch: 125%;
  }
  .retour {
    text-decoration: none;
    display: inline-flex;
    gap: 0.6em;
    align-items: center;
  }
  @media (max-width: 900px) {
    .phrase,
    .meta,
    .grand,
    .prose {
      grid-column: 1 / -1;
    }
    .fonction {
      grid-template-columns: 1fr;
    }
    .faits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }
    .meta {
      grid-template-columns: 1fr;
    }
    .logo {
      top: calc(var(--nav-h) + 1rem);
      left: 50%;
      right: auto;
      width: min(70vw, 42svh);
      translate: -50% 0;
    }
  }
</style>
