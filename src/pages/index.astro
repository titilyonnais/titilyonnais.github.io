---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Methode from '../components/Methode.astro';
import APropos from '../components/APropos.astro';
import Contact from '../components/Contact.astro';
import SceneProduit from '../components/scenes/SceneProduit.astro';
import PostShipFenetre from '../demos/postship/Fenetre.astro';
import ClipperFenetre from '../demos/clipper/Fenetre.astro';
import ClipperTouches from '../demos/clipper/Touches.astro';
import Aether from '../components/scenes/Aether.astro';
import { getEntry } from 'astro:content';

const postship = (await getEntry('projets', 'postship'))!;
const clipper = (await getEntry('projets', 'clipper'))!;
const aether = (await getEntry('projets', 'aether'))!;
---
<Base
  title="Thibault Morretton — créateur de logiciels"
  description="Je fabrique des logiciels : PostShip, la surveillance après mise en ligne ; Clipper, un presse-papiers pour Windows ; ÆTHER, un navigateur sans onglets."
>
  <Hero />
  <Methode />
  <SceneProduit projet={postship} fond="ink" numero="01" pin={4} largeur={1200} hauteur={750} largeurMobile={400} hauteurMobile={760} teinte="--teinte-postship">
    <PostShipFenetre />
  </SceneProduit>
  <SceneProduit projet={clipper} fond="ink" numero="02" pin={4} largeur={1112} hauteur={520} largeurMobile={400} hauteurMobile={780} teinte="--teinte-clipper">
    <ClipperFenetre />
    <ClipperTouches slot="theatre" />
  </SceneProduit>
  <Aether projet={aether} />
  <APropos />
  <Contact />
</Base>
