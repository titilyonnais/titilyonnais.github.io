---
// Page de composition de l'image de partage (1200 × 630), capturée par scripts/og.mjs.
import '../styles/tokens.css';
import '../styles/base.css';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <title>og</title>
  </head>
  <body class="ink">
    <p class="qui mono">Thibault Morretton · créateur de logiciels</p>
    <div class="logos">
      <img src="/produits/postship/logo.svg" alt="" />
      <img src="/produits/clipper/tuile.svg" alt="" />
      <img src="/produits/aether/icone.png" alt="" />
    </div>
    <p class="phrase">Trois logiciels en service.<br />D’autres en route.</p>
  </body>
</html>
<style>
  body {
    width: 1200px;
    height: 630px;
    overflow: hidden;
    display: grid;
    grid-template-rows: auto 1fr auto;
    padding: 56px 64px;
  }
  .qui {
    text-transform: uppercase;
    font-size: 18px;
  }
  .logos {
    display: flex;
    gap: 64px;
    align-items: center;
    justify-content: flex-end;
  }
  .logos img {
    height: 150px;
    width: auto;
  }
  .phrase {
    font-size: 84px;
    font-weight: 450;
    letter-spacing: var(--track-title);
    line-height: 0.92;
    max-width: none;
  }
</style>
